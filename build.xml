<?xml version="1.0"?>
<project name="aarithmetic" default="jar">
  <property name="src.dir" value="."/>
  <property name="build.dir" value="build"/>
  <property name="jar.dir" value="arbitraryarithmetic"/>
  <property name="main-class" value="MyInfArith"/>

  <target name="clean">
    <delete dir="${build.dir}"/>
    <delete file="${jar.dir}/aarithmetic.jar"/>
  </target>

  <target name="compile">
    <mkdir dir="${build.dir}"/>
    <javac srcdir="${src.dir}" destdir="${build.dir}" includeantruntime="false"/>
  </target>

  <target name="jar" depends="compile">
    <mkdir dir="${jar.dir}"/>
    <jar destfile="${jar.dir}/aarithmetic.jar" basedir="${build.dir}">
      <manifest>
        <attribute name="Main-Class" value="${main-class}"/>
      </manifest>
    </jar>
  </target>

  <target name="run" depends="jar">
    <java jar="${jar.dir}/aarithmetic.jar" fork="true">
      <arg value="float"/>
      <arg value="div"/>
      <arg value="244727.15202"/>
      <arg value="75964.3891"/>
    </java>
  </target>
</project>

